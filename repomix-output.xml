                                    </div>
                                    <div>
                                      <Label>Task Type</Label>
                                      <p className="font-medium">{task.type}</p>
                                    </div>
                                    <div>
                                      <Label>Priority</Label>
                                      <Badge className={getPriorityColor(task.priority)}>
                                        {task.priority}
                                      </Badge>
                                    </div>
                                    <div>
                                      <Label>Status</Label>
                                      <Badge className={getStatusColor(task.status)}>
                                        {task.status}
                                      </Badge>
                                    </div>
                                    <div>
