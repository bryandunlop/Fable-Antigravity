                <Button
                  onClick={handleSubmit}
                  disabled={!selectedDocument || !proposalForm.title || !proposalForm.description}
                  className="flex items-center gap-2"
                >
                  <Send className="w-4 h-4" />
                  Submit Proposal
                </Button>
              </div>
            </div>
          )}
          
          {activeTab !== 'create' && (
            <Button variant="outline" onClick={onClose}>
              Close
            </Button>
          )}
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
