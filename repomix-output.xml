  // Derive action items from Hazard Workflow
  const getHazardTasks = (): ActionItem[] => {
    const tasks: ActionItem[] = [];

    hazards.forEach(hazard => {
      // Helper to cast priority safely
      const getPriority = (sev?: string): 'Critical' | 'High' | 'Medium' | 'Low' => {
