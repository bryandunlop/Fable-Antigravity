}

html {
  font-size: var(--font-size);
}

/* Aviation Blue Theme Enhancements */
@layer components {
  /* Enhanced blue gradients for special elements */
  .aviation-gradient {
    background: linear-gradient(135deg, #0037B1 0%, #00A1DF 50%, #44BEEE 100%);
  }
  
  .aviation-gradient-subtle {
    background: linear-gradient(135deg, rgba(0, 55, 177, 0.1) 0%, rgba(0, 161, 223, 0.1) 50%, rgba(68, 190, 238, 0.1) 100%);
  }
  
  /* Blue-themed shadows */
  .aviation-shadow {
    box-shadow: 0 4px 20px rgba(0, 161, 223, 0.15);
  }
  
  .aviation-shadow-lg {
    box-shadow: 0 10px 40px rgba(0, 161, 223, 0.2);
  }
  
  /* Enhanced focus states with blue */
  .aviation-focus {
    @apply focus:ring-2 focus:ring-accent/50 focus:border-accent;
  }
  
  /* Special blue variants for important elements */
  .btn-aviation-primary {
    @apply bg-primary hover:bg-primary/90 text-primary-foreground;
    box-shadow: 0 2px 8px rgba(0, 55, 177, 0.2);
  }
  
  .btn-aviation-secondary {
    @apply bg-secondary hover:bg-secondary/90 text-secondary-foreground;
    box-shadow: 0 2px 8px rgba(68, 190, 238, 0.2);
  }
  
  .btn-aviation-accent {
    @apply bg-accent hover:bg-accent/90 text-accent-foreground;
    box-shadow: 0 2px 8px rgba(0, 161, 223, 0.2);
  }
  
  /* Enhanced card styling with blue accents */
  .aviation-card {
    @apply bg-card border border-border/50 rounded-lg;
    box-shadow: 0 1px 3px rgba(0, 161, 223, 0.05);
  }
  
  .aviation-card-featured {
    @apply bg-card border-2 border-accent/20 rounded-lg;
    box-shadow: 0 4px 12px rgba(0, 161, 223, 0.1);
  }
  
  /* Enhanced shadow variants */
  .aviation-shadow-xl {
    box-shadow: 0 25px 50px rgba(0, 161, 223, 0.25);
  }
  
  /* Border width utilities */
  .border-3 {
    border-width: 3px;
  }
  
  /* Enhanced button glow effects */
  .request-button-glow {
    position: relative;
    overflow: hidden;
  }
  
  .request-button-glow::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
    transition: left 0.5s;
