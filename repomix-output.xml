                          <a href={`tel:${event.hotelPhone}`} className="text-primary hover:underline">
                            📞 {event.hotelPhone}
                          </a>
                        )}
                      </div>
                    )}

                    {event.type === 'ground-transport' && (
                      <div className="space-y-1">
                        {event.driverName && <div>🚗 Driver: {event.driverName}</div>}
