        status: 'low-stock',
        aircraftCompatibility: ['G650', 'G650ER']
      },
      {
        id: '2',
        partNumber: 'G650-AVN-042',
        description: 'Primary Flight Display Unit',
        category: 'Avionics',
        currentStock: 0,
        minStock: 1,
        maxStock: 3,
        unitCost: 125000.00,
        totalValue: 0,
        vendor: 'Honeywell',
        location: 'Secure Storage',
