              {!isActionItem && (
                <Button
                  variant="outline"
                  size="sm"
                  onClick={() => {
                    setEditingPersonalTask(task as PersonalTask);
                    setIsEditPersonalTaskDialogOpen(true);
                  }}
                >
                  <Edit className="w-4 h-4" />
                </Button>
              )}
            </div>
          </div>
        </CardContent>
      </Card>
    );
