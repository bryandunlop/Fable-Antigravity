                    </div>

                    <div className="space-y-2">
                      <Label>Traveler Email</Label>
                      <Input
                        type="email"
                        value={currentItinerary.travelerEmail || ''}
                        onChange={(e) => setCurrentItinerary({
                          ...currentItinerary,
                          travelerEmail: e.target.value
                        })}
                        placeholder="email@company.com"
