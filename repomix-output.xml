      attachments: ['Crew_Fatigue_SelfAssessment.pdf'],
      approvalChain: [
        { step: 1, role: 'Submitter', name: 'Sarah Wilson', status: 'submitted', date: '2024-02-01 16:00', comment: 'Requesting 2-hour FDP extension for repositioning.' },
