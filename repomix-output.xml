        urgency: 'routine'
      },
      {
        id: '2',
        poNumber: 'PO-2024-1002',
        vendor: 'Honeywell',
        parts: [
          {
            partNumber: 'G650-AVN-042',
            description: 'Primary Flight Display Unit',
            quantity: 1,
            unitCost: 125000.00,
            totalCost: 125000.00
          }
        ],
        totalAmount: 125000.00,
        orderDate: '2024-12-29',
        expectedDelivery: '2025-02-15',
        status: 'pending',
        urgency: 'aog'
      }
    ]);

    setVendors([
      {
        id: '1',
        name: 'Rolls-Royce',
        contact: 'John Smith',
