      <div id="fleet-map" className="w-full z-0" style={{ height: '800px', filter: 'brightness(0.85)' }} />

      {/* Top Left Overlay - Title & Status */}
      <div className="absolute top-4 left-4 z-[5000] pointer-events-auto">
