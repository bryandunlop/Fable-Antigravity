                      </div>
                      <div className="text-sm text-muted-foreground">
                        <p>To: {notification.recipients.join(', ')}</p>
                        <p>
                          {notification.status === 'sent' && notification.sentAt &&
                            `Sent: ${notification.sentAt.toLocaleString()}`
