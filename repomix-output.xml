                <TaskCard key={task.id} task={task} isActionItem={false} />
              ))
            )}
          </div>
        </TabsContent>
      </Tabs>

      {/* New Personal Task Dialog */}
      <Dialog open={isNewPersonalTaskDialogOpen} onOpenChange={setIsNewPersonalTaskDialogOpen}>
