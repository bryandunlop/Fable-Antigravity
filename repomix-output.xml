    useEffect(() => {
      const stored = localStorage.getItem(key);
      if (stored) {
        setter(JSON.parse(stored));
      } else {
        setter(initialValue);
        localStorage.setItem(key, JSON.stringify(initialValue));
      }
    }, []);
