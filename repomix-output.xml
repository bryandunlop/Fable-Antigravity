                            <div>{aircraft.callSign}</div>
                            <div>{aircraft.flightPhase} • {aircraft.altitude.toLocaleString()} ft</div>
                            <div>{aircraft.groundSpeed} kts • {aircraft.heading}°</div>
                          </div>
