                                  </h4>
                                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    <div className="bg-background/80 p-3 rounded-lg border border-border/50">
                                      <span className="text-muted-foreground block text-[10px] font-bold uppercase tracking-widest mb-1">Favorite Dishes</span>
                                      <span className="font-medium text-sm">{passenger.foodPreferences.favoriteDishes.join(', ')}</span>
                                    </div>
                                    <div className="bg-background/80 p-3 rounded-lg border border-border/50">
                                      <span className="text-muted-foreground block text-[10px] font-bold uppercase tracking-widest mb-1">Disliked Foods</span>
                                      <span className="font-medium text-sm">{passenger.foodPreferences.avoidedFoods.join(', ')}</span>
                                    </div>
                                  </div>
                                </div>
                              </div>

                              {/* Service Column 2 */}
                              <div className="space-y-6">
                                {/* Beverage Preferences */}
                                <div className="space-y-3">
                                  <h4 className="font-bold text-lg flex items-center gap-2">
                                    <Coffee className="w-5 h-5 text-muted-foreground" />
                                    Beverage Preferences
                                  </h4>
                                  <div className="bg-background/80 p-3 rounded-lg border border-border/50">
                                    <span className="text-muted-foreground block text-[10px] font-bold uppercase tracking-widest mb-1">Preferred Beverages</span>
                                    <span className="font-medium text-sm">{passenger.beveragePreferences.join(', ')}</span>
                                  </div>
                                </div>

                                {/* Special Requests */}
                                {passenger.preferences.specialRequests && (
                                  <div className="space-y-3">
                                    <h4 className="font-bold text-lg flex items-center gap-2">
                                      <Sparkles className="w-5 h-5 text-muted-foreground" />
                                      Special Requests
                                    </h4>
                                    <div className="bg-background/80 p-3 rounded-lg border border-border/50">
                                      <span className="font-medium text-sm">{passenger.preferences.specialRequests}</span>
                                    </div>
                                  </div>
                                )}
                              </div>
                            </div>
                          </CardContent>
                        </Card>
                      ))}
                    </div>
                  </div>
                </div>
              )}
            </Card>
          );
        })}
      </div>

      {filteredFlightLegs.length === 0 && (
        <Card>
          <CardContent className="p-8 text-center">
            <Plane className="w-12 h-12 text-muted-foreground mx-auto mb-4" />
            <p className="text-muted-foreground">No flights match the current filters.</p>
          </CardContent>
        </Card>
      )}
    </div>
  );
}
</file>

<file path="src/index.css">
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
@import "tailwindcss";

@layer base {
  :root {
    /* P&G Aviation Premium Palette */
    --pg-blue: #0F172A;
    /* Slate 900 */
    --pg-blue-light: #1E293B;
    /* Slate 800 */
    --pg-accent: #3B82F6;
    /* Blue 500 */
    --pg-accent-hover: #2563EB;
    /* Blue 600 */
    --pg-slate: #64748B;
    /* Slate 500 */

    /* Semantic Colors */
    --background: #F8FAFC;
    /* Slate 50 */
    --foreground: #0F172A;
    /* Slate 900 */

    --card: #FFFFFF;
    --card-foreground: #0F172A;

    --popover: #FFFFFF;
    --popover-foreground: #0F172A;

    --primary: #0F172A;
    --primary-foreground: #F8FAFC;

    --secondary: #F1F5F9;
    /* Slate 100 */
    --secondary-foreground: #0F172A;

    --muted: #F1F5F9;
    --muted-foreground: #64748B;

    --accent: #EFF6FF;
    /* Blue 50 */
    --accent-foreground: #1E40AF;
    /* Blue 800 */

    --destructive: #EF4444;
    --destructive-foreground: #F8FAFC;

    --border: #E2E8F0;
    --input: #E2E8F0;
    --ring: #94A3B8;
    /* Slate 400 */

    /* Premium Gradients - Light */
    --gradient-body: linear-gradient(to bottom right, #F8FAFC, #EFF6FF, #F8FAFC);

    /* Chart Colors */
    --chart-1: #0F172A;
    --chart-2: #3B82F6;
    --chart-3: #64748B;
    --chart-4: #94A3B8;
    --chart-5: #CBD5E1;
  }

  /* Dark Mode Overrides */
  .dark {
    --background: #020617;
    /* Slate 950 */
    --foreground: #F8FAFC;
    /* Slate 50 */

    --card: #0F172A;
    /* Slate 900 */
    --card-foreground: #F8FAFC;

    --popover: #0F172A;
    --popover-foreground: #F8FAFC;

    --primary: #F8FAFC;
    --primary-foreground: #0F172A;

    --secondary: #1E293B;
    /* Slate 800 */
    --secondary-foreground: #F8FAFC;

    --muted: #1E293B;
    --muted-foreground: #94A3B8;
    /* Slate 400 */

    --accent: #1E293B;
    --accent-foreground: #F8FAFC;

    --destructive: #7F1D1D;
    --destructive-foreground: #F8FAFC;

    --border: #1E293B;
    --input: #1E293B;
    --ring: #334155;

    --pg-blue: #F8FAFC;
    --pg-slate: #94A3B8;

    /* Premium Gradients - Dark */
    --gradient-body-dark: linear-gradient(to bottom right, #020617, #0F172A, #020617);
  }
}

@theme {
  --font-sans: "Inter", ui-sans-serif, system-ui, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji";
  --font-mono: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace;

  /* Modern Radius System */
  --radius: 0.75rem;
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 8px);

  /* Animation Durations */
  --animate-duration-fast: 200ms;
  --animate-duration-normal: 300ms;
  --animate-duration-slow: 500ms;

  /* Map to CSS Variables */
  --color-background: var(--background);
  --color-foreground: var(--foreground);

  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);

  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);

  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);

  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);

  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);

  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);

  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);

  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);

  --color-pg-blue: var(--pg-blue);
  --color-pg-blue-light: var(--pg-blue-light);
  --color-pg-accent: var(--pg-accent);
  --color-pg-accent-hover: var(--pg-accent-hover);
  --color-pg-slate: var(--pg-slate);

  /* Keyframes */
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pulse-subtle {

    0%,
    100% {
      opacity: 1;
    }

    50% {
      opacity: 0.8;
      transform: scale(0.98);
    }
  }

  @keyframes pulse-glow {

    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }

    50% {
      opacity: 0.8;
      transform: scale(0.98);
    }
  }

  @keyframes gradient-x {

    0%,
    100% {
      background-position: 0% 50%;
    }

    50% {
      background-position: 100% 50%;
    }
  }

  --animate-fade-in: fade-in 0.6s ease-out forwards;
  --animate-slide-up: slide-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  --animate-pulse-subtle: pulse-subtle 3s ease-in-out infinite;
  --animate-pulse-glow: pulse-glow 3s ease-in-out infinite;
  --animate-gradient-x: gradient-x 15s ease infinite;

  /* Custom UI Polish Animations */
  @keyframes list-stagger {
    0% {
      opacity: 0;
      transform: translateY(10px);
    }

    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  --animate-list-stagger: list-stagger 0.4s ease-out forwards;

  /* Custom SVG Checkmark & Plane */
  @keyframes dash {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes takeoff-arc {
    0% {
      opacity: 0;
      transform: translate(-20px, 20px) rotate(-30deg) scale(0.5);
    }

    20% {
      opacity: 1;
    }

    100% {
      opacity: 1;
      transform: translate(60px, -60px) rotate(45deg) scale(1.5);
    }
  }

  @keyframes fly-across {
    0% {
      transform: translate(-200%, 100%) scale(0.5) rotate(45deg);
      opacity: 0;
    }

    20% {
      opacity: 1;
      transform: translate(-100%, 50%) scale(1) rotate(45deg);
    }

    80% {
      opacity: 1;
      transform: translate(100%, -50%) scale(1) rotate(45deg);
    }

    100% {
      transform: translate(200%, -100%) scale(0.5) rotate(45deg);
      opacity: 0;
    }
  }
}

@layer base {
  * {
    border-color: var(--color-border);
  }

  html {
    font-family: "Inter", sans-serif;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Custom Scrollbar Styles */
  ::-webkit-scrollbar {
    width: 8px;
    height: 8px;
  }

  ::-webkit-scrollbar-track {
    background: transparent;
  }

  ::-webkit-scrollbar-thumb {
    background: rgba(100, 116, 139, 0.3);
    /* Slate-500 semantic color equivalent with opacity */
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: rgba(100, 116, 139, 0.5);
  }

  .dark ::-webkit-scrollbar-thumb {
    background: rgba(148, 163, 184, 0.3);
    /* Slate-400 for dark mode */
  }

  .dark ::-webkit-scrollbar-thumb:hover {
    background: rgba(148, 163, 184, 0.5);
  }

  body {
    background-color: var(--color-background);
    color: var(--color-foreground);
    background-image: var(--gradient-body);
    background-attachment: fixed;
    -webkit-tap-highlight-color: transparent;
    @apply antialiased transition-colors duration-500 ease-in-out;
  }

  /* Prevent text selection on UI elements typically tapped */
  button,
  a,
  .select-none {
    user-select: none;
    -webkit-user-select: none;
  }

  .dark body {
    background-image: var(--gradient-body-dark);
  }

  .status-success {
    @apply bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-950/50 dark:text-emerald-400 dark:border-emerald-900;
  }

  .status-warning {
    @apply bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-950/50 dark:text-amber-400 dark:border-amber-900;
  }

  .status-error {
    @apply bg-red-50 text-red-700 border-red-200 dark:bg-red-950/50 dark:text-red-400 dark:border-red-900;
  }

  .status-info {
    @apply bg-blue-50 text-blue-700 border-blue-200 dark:bg-blue-950/50 dark:text-blue-400 dark:border-blue-900;
  }
}

@layer components {

  /* Modern Glass Effect */
  .glass-panel {
    @apply bg-white/80 dark:bg-slate-900/80 backdrop-blur-xl border border-white/20 dark:border-slate-800/50 shadow-lg shadow-slate-200/50 dark:shadow-slate-900/50 transition-all duration-300;
  }

  .glass-panel-hover {
    @apply hover:scale-[1.01] hover:shadow-xl hover:bg-white/90 dark:hover:bg-slate-900/90 transition-all duration-300;
  }

  /* Premium Glass System */
  .glass-premium {
    @apply bg-white/70 dark:bg-slate-900/60 backdrop-blur-xl border border-white/20 dark:border-slate-700/30 shadow-lg transition-all duration-300;
  }

  .glass-premium-hover {
    @apply hover:bg-white/80 dark:hover:bg-slate-900/80 hover:scale-[1.01] hover:shadow-xl hover:shadow-blue-500/10 transition-all duration-500 ease-out;
  }

  /* Premium Card */
  .premium-card {
    @apply bg-card text-card-foreground rounded-xl border shadow-sm transition-all duration-300 hover:shadow-md hover:border-blue-500/30;
  }

  /* Aviation Gradient Text */
  .text-aviation-gradient {
    @apply bg-clip-text text-transparent bg-gradient-to-r from-slate-900 to-blue-600 dark:from-white dark:to-blue-400;
  }

  /* Status Indicators */
  .status-badge {
    @apply px-2.5 py-0.5 rounded-full text-xs font-medium border shadow-sm;
  }

  /* Colored Shadows for Context */
  .shadow-glow-blue {
    @apply shadow-lg shadow-blue-500/20 dark:shadow-blue-500/10;
  }

  .shadow-glow-green {
    @apply shadow-lg shadow-emerald-500/20 dark:shadow-emerald-500/10;
  }

  .shadow-glow-orange {
    @apply shadow-lg shadow-orange-500/20 dark:shadow-orange-500/10;
  }

  .shadow-glow-purple {
    @apply shadow-lg shadow-purple-500/20 dark:shadow-purple-500/10;
  }
}
</file>

