                                </div>
                              )}
                              <div>
                                <p className="text-xs text-muted-foreground">ILS</p>
                                <p className="font-medium">{runway.ils ? '✓ Yes' : 'No'}</p>
                              </div>
                              {runway.le_elevation > 0 && (
                                <div>
                                  <p className="text-xs text-muted-foreground">Runway Elevations</p>
