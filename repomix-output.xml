                                }}
                              >
                                <ExternalLink className="h-4 w-4 mr-2" />
                                Join Teams Meeting
                              </Button>
                            ) : event.meetingLink.toLowerCase().includes('zoom') ? (
                              <Button
                                size="sm"
                                className="w-full justify-start"
                                onClick={(e) => {
                                  e.stopPropagation();
