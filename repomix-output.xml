            <span>Last updated: {lastRefresh.toLocaleTimeString()}</span>
          </div>
          <Button
            variant="ghost"
            size="sm"
            className="text-xs"
            onClick={() => window.open('https://nasstatus.faa.gov/', '_blank')}
          >
            <ExternalLink className="w-3 h-3 mr-1" />
            View Full NAS Status
          </Button>
        </div>
      </CardContent>
    </Card>
  );
}
