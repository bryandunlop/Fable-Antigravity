                      )
                    } />
                  </Routes>
                </Router>
              </ForeFlightSyncProvider>
            </PassengerFormProvider>
          </HazardProvider>
        </MaintenanceProvider>
      </NotificationProvider>
    </ThemeProvider>
  );
}
