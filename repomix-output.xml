            <div className="flex items-center justify-center gap-2">
              <Badge className="bg-yellow-100 text-yellow-800">5 pending</Badge>
              <ArrowRight className="w-4 h-4" />
            </div>
          </CardContent>
        </Card>

        {/* Active Collaborations */}
