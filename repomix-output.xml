                                </div>
                              )}
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}

                  {/* Approach Data from FAA */}
                  {selectedSubmission.faaData.approaches && selectedSubmission.faaData.approaches.length > 0 && (
                    <div className="bg-white border border-blue-200 rounded-lg p-4">
