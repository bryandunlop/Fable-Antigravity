                            placeholder="Any additional notes for implementation, training requirements, etc."
                            rows={2}
                          />
                        </div>
                      </CardContent>
                    </Card>
                  </>
                )}
              </div>
            </ScrollArea>
          </TabsContent>

          <TabsContent value="my-proposals" className="h-full">
            <ScrollArea className="h-[420px] lg:h-[520px] pr-4">
              <div className="space-y-4">
