                            <Badge key={role} className={getRoleBadgeColor(role)}>
                              {roleOptions.find(r => r.value === role)?.label || role}
                            </Badge>
                          ))}
                        </div>
                        <div className="flex flex-wrap gap-4 text-xs">
                          <span className="flex items-center gap-1">
                            <User className="w-3 h-3" />
