              <Label>Tags</Label>
              {newPersonalTaskForm.tags.map((tag, index) => (
                <div key={index} className="flex gap-2">
                  <Input
                    placeholder="Enter tag"
                    value={tag}
                    onChange={(e) => updateTagField(index, e.target.value)}
