        }
    ]);
    const [sharedLinks, setSharedLinks] = useState<SharedFormLink[]>([]);

    // Calculate expiration data for all submissions
    useEffect(() => {
        setSubmissions(prev => prev.map(submission => {
            const dataAge = calculateDataAge(submission.submittedAt);
