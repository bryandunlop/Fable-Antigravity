  }, []);

  // Filter and sort crew data
  const filteredCrew = crewMembers
    .filter(crew => {
      if (filterPosition !== 'all' && crew.position !== filterPosition) return false;
      if (filterBase !== 'all' && crew.base !== filterBase) return false;
