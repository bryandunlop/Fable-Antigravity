  const [utilizationFilter, setUtilizationFilter] = useState<'all' | 'over' | 'under'>('all');
  const [dateRange, setDateRange] = useState<'3M' | '6M' | '12M'>('6M');
  const [showOutliersOnly, setShowOutliersOnly] = useState(false);
