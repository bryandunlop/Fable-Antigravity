  ]);

  // Request form state
  const [requestForm, setRequestForm] = useState({
    type: 'change' as 'change' | 'update',
    title: '',
    category: '',
    description: '',
    justification: '',
    priority: 'medium' as 'low' | 'medium' | 'high' | 'urgent',
    deadline: '',
