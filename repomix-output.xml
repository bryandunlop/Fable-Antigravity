          case 'twoMonths': return crew.twoMonthsOut.ronDays;
        }
      }
    },
    {
      id: 'standby-days',
      name: 'Standby Days',
      description: 'Days on standby duty',
      weight: 3, // Weight now represents days instead of percentage
