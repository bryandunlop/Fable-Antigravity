                    <span className="font-semibold">$125,000</span>
                  </div>
                  <div className="flex justify-between">
                    <span>Hydraulics</span>
                    <span className="font-semibold">$70,000</span>
                  </div>
                  <div className="flex justify-between">
                    <span>Interior</span>
                    <span className="font-semibold">$3,840</span>
                  </div>
                </div>
              </CardContent>
            </Card>
          </div>
        </TabsContent>
      </Tabs>
    </div>
