  title: string;
  description: string;
  type: 'tip' | 'warning' | 'info';
  shortcut?: string;
}

interface ContextualHelpProps {
  page: string;
  userRole: string;
}

const helpContent: Record<string, HelpTip[]> = {
  'dashboard': [
    {
      id: 'quick-actions',
      title: 'Quick Actions',
      description: 'Use the role-specific quick action cards to access your most common tasks quickly.',
      type: 'tip'
    },
    {
      id: 'command-palette',
