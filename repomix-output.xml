                            <Button size="sm" onClick={() => acknowledgeAlert(alert.id)}>
                              Acknowledge
                            </Button>
                            <Button size="sm" variant="outline">
                              Create PO
                            </Button>
                          </>
                        )}
                        {alert.acknowledged && (
                          <Badge className="bg-green-100 text-green-800">
                            <CheckCircle className="h-3 w-3 mr-1" />
                            Acknowledged
