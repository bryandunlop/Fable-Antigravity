            "db:studio": "drizzle-kit studio",
            "test": "vitest run",
            "test:watch": "vitest",
            "gen:myairops": "openapi-typescript src/integration/myairops/schemas/crm.json -o src/integration/myairops/gen/crm.ts && openapi-typescript src/integration/myairops/schemas/booking.json -o src/integration/myairops/gen/booking.ts && openapi-typescript src/integration/myairops/schemas/maintenance.json -o src/integration/myairops/gen/maintenance.ts"
